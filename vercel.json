{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/aufgaben", "destination": "/cockpit" },
    { "source": "/datenraeume", "destination": "/cockpit" },
    { "source": "/kommunikation", "destination": "/cockpit" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
