{
  "name": "lumina-security-baseline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.x"
  },
  "scripts": {
    "test": "npm run test:syntax && npm run test:role-resolver && npm run test:onboarding && npm run test:provisioning && npm run test:bootstrap && npm run test:phase2-schema && npm run test:http && npm run test:auth-guard && npm run test:role-cockpits && npm run test:rls:plan && npm run test:secrets",
    "test:syntax": "node tools/check-syntax.mjs",
    "test:http": "node tools/test-http-smoke.mjs",
    "test:auth-guard": "node tools/test-auth-guard.mjs",
    "test:role-cockpits": "node tools/test-role-cockpits.mjs",
    "test:role-resolver": "node --test tests/role-resolver.test.mjs",
    "test:onboarding": "node --test tests/test-user-onboarding.test.mjs",
    "test:provisioning": "node --test tests/provision-lumina-test-users.test.mjs",
    "test:bootstrap": "node --test tests/bootstrap-lumina-test-project.test.mjs",
    "bootstrap:test-project:dry-run": "node tools/bootstrap-lumina-test-project.mjs --dry-run",
    "bootstrap:test-project:apply": "node tools/bootstrap-lumina-test-project.mjs --apply",
    "test:phase2-schema": "node --test tests/phase2-migrations.test.mjs",
    "test:rls:plan": "node tools/test-rls-matrix.mjs --plan",
    "test:env": "node --env-file-if-exists=.env.test tools/check-test-environment.mjs",
    "test:rls": "node --env-file-if-exists=.env.test tools/test-rls-matrix.mjs",
    "test:rls:privileges": "node --env-file-if-exists=.env.test tools/test-rls-matrix.mjs --probes-only",
    "test:rls:all": "npm run test:rls && npm run test:rls:proofs && npm run test:artifacts",
    "test:rls:proofs": "node --env-file-if-exists=.env.test tools/test-security-target-model.mjs",
    "test:artifacts": "node --env-file-if-exists=.env.test tools/check-test-artifacts.mjs",
    "test:secrets": "node tools/check-secrets.mjs",
    "test:fixtures": "node --env-file-if-exists=.env.test tools/prepare-test-fixtures.mjs",
    "test:fixtures:cleanup": "node --env-file-if-exists=.env.test tools/prepare-test-fixtures.mjs --cleanup",
    "test:migrations": "node tools/test-migrations-from-zero.mjs",
    "test:migrations:list": "node --env-file-if-exists=.env.test tools/manage-test-migrations.mjs --list",
    "test:migrations:push": "node --env-file-if-exists=.env.test tools/manage-test-migrations.mjs --push",
    "test:financial:legacy": "node tools/test-financial-pipeline.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8"
  }
}
